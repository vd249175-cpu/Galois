{
  "id": "editor",
  "name": "Lattice Editor",
  "version": "1.0.0",
  "description": "Custom Markdown note editor with real-time tag editing, wiki links, media drop support, and reactive python execution bindings.",
  "dependencies": [],
  "bloodChannels": [
    "system.projectPath",
    "system.resolvedTags",
    "system.staticTags",
    "system.focusedAreaId",
    "system.activeEditors",
    "system.lastFocusedEditorId",
    "events.openFile.editor-root",
    "events.openFile.${areaId}",
    "events.fileSaved.*",
    "events.scriptJson:"
  ],
  "triggerConditions": {
    "open": "events.openFile.${areaId}",
    "save": "actions.editor.save.${areaId}",
    "toggleMode": "actions.editor.toggleMode.${areaId}"
  }
}
