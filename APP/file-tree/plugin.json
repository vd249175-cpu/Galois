{
  "id": "fileTree",
  "name": "Lattice Explorer",
  "version": "1.0.0",
  "description": "File explorer and notebook tree manager for Lattice markdown note archives.",
  "dependencies": [],
  "bloodChannels": [
    "system.projectPath",
    "system.resolvedTags",
    "system.staticTags",
    "system.maxIterations",
    "system.lastFocusedEditorId",
    "system.activeEditors",
    "events.fileSaved.*"
  ],
  "triggerConditions": {
    "click": "events.openFile.${targetEditorId}"
  }
}
